### Initial .env file. Required for docker-compose to work.
# Select the application environment: development, test, or production.
ENV_STATE=development
VERSION=0.6.0
POSTGRES_USER=

# Application
TIMEZONE=UTC
SECRET_KEY=REPLACE_WITH_A_STRONG_UNIQUE_PRODUCTION_SECRET
VERSION=0.6.0
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis
REDIS_URL=redis://REDIS_HOST:6379/0
REDIS_MAX_CONNECTIONS=50

# Email
EMAIL_HOSTNAME=SMTP_HOST
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USERNAME=SMTP_USERNAME
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_PASSWORD

# Celery
CELERY_BROKER_URL=redis://REDIS_HOST:6379/1
CELERY_RESULT_BACKEND=redis://REDIS_HOST:6379/2

# Logging
LOG_LEVEL=INFO
SQLALCHEMY_LOG_LEVEL=WARNING
LOG_DIR=logs
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5
